.venv/
__pycache__/
*.pyc
.env
.env.*
*.key
*.pem
credentials*.json
.DS_Store
.claude/settings.local.json
spikes/out/

# runtime job state; the committed demo under data/demo/ is the exception
data/*
!data/demo/
!data/demo/**
# The manual cache baked into the container image. Only the hand-checked excerpts
# listed below are source and travel with the repo. Everything else in this directory
# is ignored on purpose: a runtime lookup writes its own <model>.json here carrying
# manual_path — the absolute path of the PDF on whoever's machine ran it — and this
# repo is public. Adding a model with tools/bake_manual_cache.py means adding a line
# here too, which is the moment to decide that excerpt should be published.
!data/manuals/
data/manuals/*
!data/manuals/index.json
!data/manuals/westinghouse-epx3030.json
!data/manuals/ryobi-ry31012.json
!data/manuals/ryobi-ry40lb01k.json

# setuptools wheel-build scratch (tools/ and the Dockerfile both build out-of-tree)
build/

# Build metadata regenerated by `pip install -e .` — not source. It was tracked until
# 2026-09-11, which meant every editable install produced a spurious diff in a public repo.
src/*.egg-info/
